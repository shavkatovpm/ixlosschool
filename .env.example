# Ariza formasi -> Telegram (majburiy: bo'lmasa production'da forma 503 qaytaradi)
# 1) @BotFather orqali bot yarating va tokenni oling
# 2) Botni qabul bo'limi guruhiga/chatiga qo'shing, chat_id ni oling
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Analitika va tasdiqlash kodlari admin panelda (Sozlamalar) kiritiladi. Quyidagilar faqat panel
# bo'lmagan joy (masalan Vercel) uchun zaxira qiymat; panelda saqlangan qiymat ustun turadi.
NEXT_PUBLIC_GA_ID=        # masalan G-XXXXXXXXXX
NEXT_PUBLIC_YM_ID=        # Yandex Metrica hisoblagich raqami
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=

# Admin panel (/admin). Needs a writable database, so it is enabled only on the droplet.
# Create the first admin with: npm run admin:create (locally) or the tools/ script in the container.
ADMIN_ENABLED=
DATABASE_PATH=        # default ./data/ixlos.db; on the droplet /data/ixlos.db
UPLOAD_DIR=           # uploaded photos; default <DATABASE_PATH folder>/uploads
BACKUP_DIR=           # database copies; default <DATABASE_PATH folder>/backups
